---
/**
 * Shown whenever a day or a card has draft: true. Only the director clears a
 * draft flag on clinical content, so this banner is the honest state of most
 * of the site for a while. It must be impossible to miss and must not look
 * like an error.
 */
interface Props {
  /** What the reader is looking at, so a card is not called a day. */
  what?: string;
}
const { what = "day" } = Astro.props;
---

<div class="draft-banner" role="status">
  <strong>DRAFT</strong> — this {what} has not been cleared by the rotation director. Numbers and
  wording may change. Do not rely on it clinically.
</div>
