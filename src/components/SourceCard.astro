---
/**
 * One ledger row, rendered. Links go to DOI resolvers, PubMed, DailyMed and
 * society sites only (planning brief §3.3: no EZproxy).
 *
 * A regulatory or society document has no DOI and no PMID and never will.
 * The card used to tell the reader to consult an internal debt file (audit
 * P2-020); it now resolves the DailyMed set id recorded in the citation, or
 * the society URL, so every row has a working link.
 */
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"ledger">;
}
const { entry } = Astro.props;
const s = entry.data;

const DESIGN: Record<string, string> = {
  rct: "randomized trial",
  meta_rct: "meta-analysis of RCTs",
  cohort: "cohort",
  case_series: "case series",
  guideline: "guideline",
  consensus_statement: "consensus statement",
  advisory: "advisory",
};

const superseded = s.currency.startsWith("superseded_by:") ? s.currency.slice("superseded_by:".length) : null;

/* Regulatory and society rows carry their identifier inside the citation:
   a DailyMed set id, or a URL. Surface whichever is there as a link. */
const setId = /DailyMed set ID ([0-9a-f-]{36})/i.exec(s.citation)?.[1] ?? null;
const url = /(https?:\/\/[^\s)]+)/.exec(s.citation)?.[1]?.replace(/[.,;]$/, "") ?? null;
const fallback = setId
  ? { href: `https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=${setId}`, label: "FDA label (DailyMed)" }
  : url
    ? { href: url, label: "Society document" }
    : null;
---

<article class="src" id={`src-${s.key}`}>
  <div class="head">
    <span class="key">[[{s.key}]]</span>
    <span class="badge">{DESIGN[s.design] ?? s.design}</span>
    <span class="badge">{s.year ?? "year unverified"}</span>
    <span class="badge">n: {s.n}</span>
    <span class:list={["badge", s.access]}>{s.access}</span>
    {s.currency === "era_limited" && <span class="badge">era-limited</span>}
    {superseded && (
      <span class="badge">
        superseded by <a href={`#src-${superseded}`}>{superseded}</a>
      </span>
    )}
  </div>
  <p class="cit">{s.citation}</p>
  <p class="supports">{s.supports}</p>
  <div class="links">
    {s.doi && (
      <a href={`https://doi.org/${s.doi}`} rel="noopener noreferrer" target="_blank">
        doi:{s.doi}
      </a>
    )}
    {s.pmid && (
      <a href={`https://pubmed.ncbi.nlm.nih.gov/${s.pmid}/`} rel="noopener noreferrer" target="_blank">
        PMID {s.pmid}
      </a>
    )}
    {!s.doi && !s.pmid && fallback && (
      <a href={fallback.href} rel="noopener noreferrer" target="_blank">{fallback.label}</a>
    )}
    {!s.doi && !s.pmid && !fallback && (
      <span class="none">No permanent identifier on record for this source</span>
    )}
  </div>
</article>
